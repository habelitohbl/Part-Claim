          <div class="sm:col-span-7">
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Part <span class="text-rose-500">*</span></label>
            <input type="text" id="form-nama-part" required placeholder="Nama komponen part..." class="w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl uppercase focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

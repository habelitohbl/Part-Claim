<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sistem Audit Claim & Dashboard Monitoring</title>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
        }
      }
    }
  </script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- SheetJS (xlsx) -->
  <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-indigo-100 selection:text-indigo-800">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- Top Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <!-- Brand / Title -->
        <div class="flex items-start sm:items-center gap-3">
          <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md shadow-indigo-200 shrink-0">
            <i data-lucide="clipboard-check" class="w-6 h-6"></i>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900">DASHBOARD AUDIT CLAIM</h1>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">II26-HabelImprovement</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Monitoring Pengajuan, Lead Time & Kendala Claim Dealer</p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-2">
          <button onclick="openClaimModal()" class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white text-xs sm:text-sm font-semibold px-3.5 py-2.5 rounded-xl shadow-sm transition cursor-pointer">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Input Claim Baru</span>
          </button>

          <label class="inline-flex items-center gap-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 text-xs sm:text-sm font-medium px-3 py-2.5 rounded-xl shadow-xs transition cursor-pointer">
            <i data-lucide="upload" class="w-4 h-4 text-slate-500"></i>
            <span>Import Excel (.xlsx)</span>
            <input type="file" id="excel-import-input" accept=".xlsx, .xls" class="hidden" onchange="handleExcelImport(event)" />
          </label>

          <button onclick="exportToExcel()" class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-medium px-3 py-2.5 rounded-xl shadow-xs transition cursor-pointer">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span>Export Excel (.xlsx)</span>
          </button>

          <button onclick="openResetConfirmModal()" class="inline-flex items-center gap-1.5 bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 text-xs sm:text-sm font-medium px-3 py-2.5 rounded-xl transition cursor-pointer" title="Kembalikan ke 61 data awal">
            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Reset Data Awal</span>
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex items-center gap-1 sm:gap-2 mt-4 pt-3 border-t border-slate-100 overflow-x-auto no-scrollbar">
        <button id="tab-btn-dashboard" onclick="switchTab('dashboard')" class="tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold transition whitespace-nowrap cursor-pointer bg-indigo-50 text-indigo-700">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
          <span>Dashboard Overview</span>
        </button>
        <button id="tab-btn-claims" onclick="switchTab('claims')" class="tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition whitespace-nowrap cursor-pointer">
          <i data-lucide="table-2" class="w-4 h-4"></i>
          <span>Data Claim & Input</span>
          <span id="badge-total-claims" class="ml-1 text-xs font-bold px-2 py-0.5 rounded-full bg-slate-200 text-slate-700">61</span>
        </button>
        <button id="tab-btn-master" onclick="switchTab('master')" class="tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition whitespace-nowrap cursor-pointer">
          <i data-lucide="database" class="w-4 h-4"></i>
          <span>Master Katalog Part & Dealer</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- ==================== TAB 1: DASHBOARD OVERVIEW ==================== -->
    <section id="view-dashboard" class="space-y-6">
      
      <!-- 6 KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
        <!-- Total Pengajuan -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Pengajuan</span>
            <div class="p-2 rounded-xl bg-blue-50 text-blue-600">
              <i data-lucide="file-text" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="kpi-total-pengajuan" class="text-2xl font-extrabold text-slate-900">61</span>
            <span class="text-xs text-slate-400">transaksi</span>
          </div>
        </div>

        <!-- Belum Adjust -->
        <div onclick="filterClaimsByStatus('Not Adjusted')" class="bg-white rounded-2xl p-4 border border-amber-200/80 shadow-xs hover:shadow-md transition cursor-pointer group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-700">Belum Adjust</span>
            <div class="p-2 rounded-xl bg-amber-50 text-amber-600 group-hover:bg-amber-100 transition">
              <i data-lucide="clock" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="kpi-belum-adjust" class="text-2xl font-extrabold text-amber-600">19</span>
            <span id="kpi-belum-pct" class="text-xs font-medium text-amber-600/80">(31.1%)</span>
          </div>
        </div>

        <!-- Sudah Adjust -->
        <div onclick="filterClaimsByStatus('Adjusted')" class="bg-white rounded-2xl p-4 border border-emerald-200/80 shadow-xs hover:shadow-md transition cursor-pointer group">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700">Sudah Adjust</span>
            <div class="p-2 rounded-xl bg-emerald-50 text-emerald-600 group-hover:bg-emerald-100 transition">
              <i data-lucide="check-circle-2" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="kpi-sudah-adjust" class="text-2xl font-extrabold text-emerald-600">42</span>
            <span id="kpi-sudah-pct" class="text-xs font-medium text-emerald-600/80">(68.9%)</span>
          </div>
        </div>

        <!-- Total Part -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Part</span>
            <div class="p-2 rounded-xl bg-violet-50 text-violet-600">
              <i data-lucide="package" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span id="kpi-total-part" class="text-2xl font-extrabold text-slate-900">63</span>
            <span class="text-xs text-slate-400">unit qty</span>
          </div>
        </div>

        <!-- Nilai Claim -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Nilai Claim</span>
            <div class="p-2 rounded-xl bg-indigo-50 text-indigo-600">
              <i data-lucide="banknote" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-3">
            <span id="kpi-nilai-claim" class="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight">Rp 24.325.511</span>
          </div>
        </div>

        <!-- Avg Lead Time -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Avg. Lead Time</span>
            <div class="p-2 rounded-xl bg-rose-50 text-rose-600">
              <i data-lucide="timer" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-3 flex items-baseline gap-1.5">
            <span id="kpi-avg-leadtime" class="text-2xl font-extrabold text-slate-900">0.0</span>
            <span class="text-xs font-medium text-slate-500">hari</span>
          </div>
        </div>
      </div>

      <!-- Charts Row -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Bar Chart: Nilai Claim & Belum Adjust per Dealer Aktif -->
        <div class="lg:col-span-7 bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
              <h2 class="text-base font-bold text-slate-900">Nilai Claim & Kasus Belum Adjust per Dealer Aktif</h2>
              <p class="text-xs text-slate-500">Perbandingan total nilai claim (Rp) dan antrian belum adjust</p>
            </div>
            <span class="text-xs font-medium px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 self-start">Dealer Aktif</span>
          </div>
          <div class="relative flex-1 min-h-[300px] w-full">
            <canvas id="dealerChart"></canvas>
          </div>
        </div>

        <!-- Doughnut Chart: Distribusi Kendala Audit Claim -->
        <div class="lg:col-span-5 bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col">
          <div class="mb-4">
            <h2 class="text-base font-bold text-slate-900">Distribusi Kendala Audit Claim</h2>
            <p class="text-xs text-slate-500">Proporsi status penyelesaian dan kendala lapangan</p>
          </div>
          <div class="relative flex-1 min-h-[300px] w-full flex items-center justify-center">
            <canvas id="kendalaChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Recap Tables Row -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Tabel Rekapitulasi Dealer -->
        <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden flex flex-col">
          <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-bold text-slate-900">Rekapitulasi Claim per Dealer</h2>
              <p class="text-xs text-slate-500">Klik baris dealer untuk melihat detail transaksi claim</p>
            </div>
            <!-- Toggle Dealer Filter -->
            <div class="inline-flex rounded-xl bg-slate-100 p-1 self-start">
              <button id="btn-dealer-active" onclick="setDealerRecapMode('active')" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-indigo-700 shadow-xs transition cursor-pointer">
                Hanya Dealer Aktif
              </button>
              <button id="btn-dealer-all" onclick="setDealerRecapMode('all')" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 transition cursor-pointer">
                Semua 34 Dealer
              </button>
            </div>
          </div>

          <div class="overflow-x-auto max-h-[420px]">
            <table class="w-full text-left border-collapse">
              <thead class="bg-slate-50 sticky top-0 z-10 border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Dealer</th>
                  <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right">Jumlah Part</th>
                  <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right">Nilai Claim (Rp)</th>
                  <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-center">Belum Adjust</th>
                </tr>
              </thead>
              <tbody id="recap-dealer-tbody" class="divide-y divide-slate-100 text-sm">
                <!-- Populated by JS -->
              </tbody>
              <tfoot class="bg-slate-50 font-bold text-slate-900 border-t-2 border-slate-200 sticky bottom-0">
                <tr>
                  <td class="py-3 px-4 text-xs uppercase">Grand Total</td>
                  <td id="recap-dealer-total-part" class="py-3 px-4 text-right">63</td>
                  <td id="recap-dealer-total-amount" class="py-3 px-4 text-right">Rp 24.325.511</td>
                  <td id="recap-dealer-total-unadjusted" class="py-3 px-4 text-center text-amber-600">19</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <!-- Tabel Rekapitulasi Kendala -->
        <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden flex flex-col">
          <div class="p-5 border-b border-slate-100">
            <h2 class="text-base font-bold text-slate-900">Rekapitulasi Kategori Kendala</h2>
            <p class="text-xs text-slate-500">Klik kendala untuk memfilter transaksi terkait</p>
          </div>

          <div class="overflow-x-auto flex-1">
            <table class="w-full text-left border-collapse">
              <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Kategori Kendala</th>
                  <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right">Kasus</th>
                  <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right">Persentase</th>
                </tr>
              </thead>
              <tbody id="recap-kendala-tbody" class="divide-y divide-slate-100 text-sm">
                <!-- Populated by JS -->
              </tbody>
              <tfoot class="bg-slate-50 font-bold text-slate-900 border-t-2 border-slate-200">
                <tr>
                  <td class="py-3 px-4 text-xs uppercase">Total Keseluruhan</td>
                  <td id="recap-kendala-total-count" class="py-3 px-4 text-right">61</td>
                  <td class="py-3 px-4 text-right">100%</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== TAB 2: DATA CLAIM & INPUT ==================== -->
    <section id="view-claims" class="hidden space-y-4">
      
      <!-- Filter & Search Bar -->
      <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-xs space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3">
          <!-- Search Input -->
          <div class="lg:col-span-4 relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input type="text" id="filter-search" oninput="renderClaimsTable()" placeholder="Cari No, Part Number, Nama Part, Dealer..." class="w-full pl-10 pr-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition" />
          </div>

          <!-- Filter Dealer -->
          <div class="lg:col-span-2">
            <select id="filter-dealer" onchange="renderClaimsTable()" class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
              <option value="">Semua Dealer</option>
            </select>
          </div>

          <!-- Filter Status -->
          <div class="lg:col-span-2">
            <select id="filter-status" onchange="renderClaimsTable()" class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
              <option value="">Semua Status</option>
              <option value="Not Adjusted">Not Adjusted (Belum)</option>
              <option value="Adjusted">Adjusted (Sudah)</option>
            </select>
          </div>

          <!-- Filter Kendala -->
          <div class="lg:col-span-3">
            <select id="filter-kendala" onchange="renderClaimsTable()" class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
              <option value="">Semua Kendala</option>
            </select>
          </div>

          <!-- Clear Filter Button -->
          <div class="lg:col-span-1 flex">
            <button onclick="resetClaimFilters()" class="w-full inline-flex items-center justify-center gap-1 px-3 py-2.5 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition cursor-pointer" title="Reset Filter">
              <i data-lucide="filter-x" class="w-4 h-4"></i>
              <span class="lg:hidden">Reset Filter</span>
            </button>
          </div>
        </div>

        <!-- Active Filter Info Bar -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-xs text-slate-500">
          <div>
            Menampilkan <span id="filtered-count" class="font-bold text-slate-800">61</span> dari <span id="total-records-count" class="font-bold text-slate-800">61</span> data transaksi
          </div>
          <div class="flex items-center gap-4">
            <span>Subtotal Nilai: <strong id="filtered-amount" class="text-indigo-700">Rp 24.325.511</strong></span>
            <span>Subtotal Qty: <strong id="filtered-qty" class="text-slate-800">63</strong></span>
          </div>
        </div>
      </div>

      <!-- Claims Data Table -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="overflow-x-auto max-h-[620px]">
          <table class="w-full text-left border-collapse whitespace-nowrap">
            <thead class="bg-slate-50 sticky top-0 z-10 border-b border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500">
              <tr>
                <th class="py-3.5 px-3 text-center">No</th>
                <th class="py-3.5 px-3">Tgl Pengajuan</th>
                <th class="py-3.5 px-3">Dealer</th>
                <th class="py-3.5 px-3">Tgl Audit</th>
                <th class="py-3.5 px-3">Part Number</th>
                <th class="py-3.5 px-3">Nama Part</th>
                <th class="py-3.5 px-3 text-center">Qty</th>
                <th class="py-3.5 px-3 text-right">Order Amount</th>
                <th class="py-3.5 px-3">Tgl Adjust</th>
                <th class="py-3.5 px-3 text-center">Status</th>
                <th class="py-3.5 px-3 text-right">Lead Time</th>
                <th class="py-3.5 px-3">Kendala</th>
                <th class="py-3.5 px-3 text-center sticky right-0 bg-slate-50 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.06)]">Aksi</th>
              </tr>
            </thead>
            <tbody id="claims-tbody" class="divide-y divide-slate-100 text-xs sm:text-sm">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ==================== TAB 3: MASTER KATALOG PART & DEALER ==================== -->
    <section id="view-master" class="hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Master Part Katalog -->
        <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden flex flex-col">
          <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-bold text-slate-900">Master Katalog Part Number</h2>
              <p class="text-xs text-slate-500">Referensi otomatis nama part dan harga satuan saat input claim baru</p>
            </div>
            <div class="flex items-center gap-2">
              <input type="text" id="search-master-part" oninput="renderMasterTables()" placeholder="Cari part..." class="px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
          </div>

          <!-- Quick Add Part Form -->
          <form onsubmit="handleAddMasterPart(event)" class="p-4 bg-slate-50/70 border-b border-slate-200 grid grid-cols-1 sm:grid-cols-12 gap-2.5">
            <div class="sm:col-span-3">
              <input type="text" id="new-part-number" required placeholder="Part Number (mis. B6YH...)" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl uppercase focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="sm:col-span-5">
              <input type="text" id="new-part-name" required placeholder="Nama Part" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl uppercase focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="sm:col-span-2">
              <input type="number" id="new-part-price" min="0" step="any" placeholder="Harga Ref (Rp)" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="w-full h-full inline-flex items-center justify-center gap-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 rounded-xl transition cursor-pointer">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>

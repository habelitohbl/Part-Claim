    function updateFormPreviews() {
      const tglPengajuan = document.getElementById('form-tgl-pengajuan').value;
      const tglAdjust = document.getElementById('form-tgl-adjust').value;
      const status = calculateStatus(tglAdjust);
      const leadTime = calculateLeadTime(tglPengajuan, tglAdjust);

      const badge = document.getElementById('preview-status-badge');
      if (status === "Adjusted") {
        badge.textContent = "Adjusted";
        badge.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800";
      } else {
        badge.textContent = "Not Adjusted";
        badge.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800";
      }

      document.getElementById('preview-leadtime-text').textContent = `${leadTime} Hari`;

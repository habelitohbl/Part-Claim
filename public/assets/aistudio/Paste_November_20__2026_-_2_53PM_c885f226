    function deleteMasterDealer(code) {
      dealersMaster = dealersMaster.filter(d => d !== code);
      saveAppState();
      renderMasterTables();
      showToast(`Dealer ${code} dihapus dari daftar master.`, "info");
    }

    // 9. EXCEL EXPORT & IMPORT (SHEETJS)
    function exportToExcel() {
      try {
        const enriched = claimsData.map(enrichClaimRecord);
        const wb = XLSX.utils.book_new();

        // Sheet 1: Dashboard Summary
        const totalPengajuan = enriched.length;
        const belumAdjust = enriched.filter(c => c.status === "Not Adjusted").length;
        const sudahAdjust = enriched.filter(c => c.status === "Adjusted").length;
        const totalPart = enriched.reduce((s, c) => s + (Number(c.qty) || 0), 0);
        const nilaiClaim = enriched.reduce((s, c) => s + (Number(c.orderAmount) || 0), 0);
        const avgLeadTime = totalPengajuan > 0
          ? Number((enriched.reduce((s, c) => s + c.leadTime, 0) / totalPengajuan).toFixed(1))
          : 0;

        const dashboardRows = [
          ["DASHBOARD AUDIT CLAIM - II26-HabelImprovement"],
          ["Tanggal Export", getTodayISO()],
          [],
          ["RINGKASAN KPI UTAMA", "NILAI"],
          ["Total Pengajuan", totalPengajuan],
          ["Belum Adjust", belumAdjust],
          ["Sudah Adjust", sudahAdjust],
          ["Total Part", totalPart],
          ["Nilai Claim (Rp)", Math.round(nilaiClaim)],
          ["Avg. Lead Time (Hari)", avgLeadTime],
          [],
          ["REKAPITULASI PER DEALER", "Jumlah Part", "Nilai Claim (Rp)", "Belum Adjust"]
        ];

        const allDealerCodes = Array.from(new Set([...dealersMaster, ...enriched.map(c => c.dealer)]));
        allDealerCodes.forEach(d => {
          const rows = enriched.filter(c => c.dealer === d);
          dashboardRows.push([
            d,
            rows.reduce((s, r) => s + (Number(r.qty) || 0), 0),
            Math.round(rows.reduce((s, r) => s + (Number(r.orderAmount) || 0), 0)),
            rows.filter(r => r.status === "Not Adjusted").length
          ]);
        });

        dashboardRows.push([]);
        dashboardRows.push(["REKAPITULASI KENDALA", "Jumlah Kasus", "Persentase (%)"]);
        const kendalaSet = new Set([...STANDARD_KENDALA_LIST, ...enriched.map(c => c.kendala)]);
        kendalaSet.forEach(k => {
          const cnt = enriched.filter(c => c.kendala === k).length;
          const pct = totalPengajuan > 0 ? Number(((cnt / totalPengajuan) * 100).toFixed(1)) : 0;
          dashboardRows.push([k, cnt, pct]);
        });

        const wsDashboard = XLSX.utils.aoa_to_sheet(dashboardRows);
        wsDashboard['!cols'] = [{ wch: 48 }, { wch: 18 }, { wch: 22 }, { wch: 16 }];
        XLSX.utils.book_append_sheet(wb, wsDashboard, "Dashboard");

        // Sheet 2: Data Transaksi
        const dataSheetRows = enriched.map(r => ({
          "No": r.no,
          "Tanggal Pengajuan Claim": r.tglPengajuan,
          "Dealer": r.dealer,
          "Tanggal Audit": r.tglAudit,
          "Part Number": r.partNumber,
          "Nama Part": r.namaPart,
          "Qty": Number(r.qty),
          "Order Amount": Number(r.orderAmount),
          "Tanggal Adjust": r.tglAdjust || "",
          "Status": r.status,
          "Lead Time": r.leadTime,
          "Kendala": r.kendala
        }));

        const wsData = XLSX.utils.json_to_sheet(dataSheetRows);
        wsData['!cols'] = [
          { wch: 6 }, { wch: 22 }, { wch: 12 }, { wch: 15 },
          { wch: 18 }, { wch: 34 }, { wch: 8 }, { wch: 16 },
          { wch: 15 }, { wch: 15 }, { wch: 12 }, { wch: 42 }
        ];
        XLSX.utils.book_append_sheet(wb, wsData, "Data");

        XLSX.writeFile(wb, `Audit_Claim_Report_${getTodayISO()}.xlsx`);
        showToast("File Excel (.xlsx) dengan 2 sheet berhasil diunduh.", "success");
      } catch (err) {
        console.error(err);
        showToast("Gagal mengekspor file Excel.", "error");
      }
    }

    function parseExcelDateCell(val) {
      if (!val) return "";
      if (typeof val === "number") {
        // Excel serial date
        const dateObj = new Date(Math.round((val - 25569) * 86400 * 1000));
        if (!isNaN(dateObj.getTime())) {
          return dateObj.toISOString().split("T")[0];
        }
      }
      const str = String(val).trim();
      if (/^\d{4}-\d{2}-\d{2}$/.test(str)) return str;
      const d = new Date(str);
      if (!isNaN(d.getTime())) return d.toISOString().split("T")[0];
      return "";
    }

    function handleExcelImport(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const sheetName = workbook.SheetNames.includes("Data") ? "Data" : workbook.SheetNames[0];
          const worksheet = workbook.Sheets[sheetName];
          const rawRows = XLSX.utils.sheet_to_json(worksheet, { defval: "" });

          const imported = [];
          rawRows.forEach((row, index) => {
            const dealer = String(row["Dealer"] || row["DEALER"] || "").trim().toUpperCase();
            const partNumber = String(row["Part Number"] || row["PART NUMBER"] || "").trim().toUpperCase();
            if (!dealer && !partNumber) return;

            imported.push({
              no: Number(row["No"]) || (index + 1),
              tglPengajuan: parseExcelDateCell(row["Tanggal Pengajuan Claim"] || row["Tgl Pengajuan"]),
              dealer,
              tglAudit: parseExcelDateCell(row["Tanggal Audit"] || row["Tgl Audit"]),
              partNumber,
              namaPart: String(row["Nama Part"] || row["NAMA PART"] || "").trim().toUpperCase(),
              qty: Number(row["Qty"]) || 1,
              orderAmount: Number(row["Order Amount"]) || 0,
              tglAdjust: parseExcelDateCell(row["Tanggal Adjust"] || row["Tgl Adjust"]),
              kendala: String(row["Kendala"] || "Verifikasi Part").trim()
            });
          });

          if (imported.length === 0) {
            showToast("Format kolom Excel tidak sesuai atau data kosong.", "error");
            return;
          }

          claimsData = imported;
          // Merge new dealers & parts
          imported.forEach(item => {
            if (item.dealer && !dealersMaster.includes(item.dealer)) {
              dealersMaster.push(item.dealer);
            }
          });
          const newCatalog = buildDefaultPartsCatalog(imported);
          newCatalog.forEach(np => {
            if (!partsMaster.some(p => p.partNumber === np.partNumber)) {
              partsMaster.push(np);
            }
          });

          saveAppState();
          refreshAllViews();
          showToast(`Berhasil mengimpor ${imported.length} transaksi dari file Excel!`, "success");
        } catch (err) {
          console.error(err);
          showToast("Terjadi kesalahan saat membaca file Excel.", "error");
        } finally {
          event.target.value = "";
        }
      };
      reader.readAsArrayBuffer(file);
    }

    // 10. RESET DATA & CONFIRMATION MODAL
    let pendingConfirmCallback = null;

    function openConfirmModal(title, desc, callback) {
      document.getElementById('confirm-modal-title').textContent = title;
      document.getElementById('confirm-modal-desc').textContent = desc;
      pendingConfirmCallback = callback;
      const modal = document.getElementById('confirm-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeConfirmModal() {
      const modal = document.getElementById('confirm-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      pendingConfirmCallback = null;
    }

    document.getElementById('confirm-modal-action-btn').addEventListener('click', () => {
      if (typeof pendingConfirmCallback === 'function') {
        pendingConfirmCallback();
      }
      closeConfirmModal();
    });

    function openResetConfirmModal() {
      openConfirmModal(
        "Reset ke 61 Data Awal?",
        "Semua perubahan atau input data baru akan dihapus dan dikembalikan ke dataset awal file II26-HabelImprovement.xlsx.",
        () => {
          localStorage.removeItem(STORAGE_KEYS.CLAIMS);
          localStorage.removeItem(STORAGE_KEYS.DEALERS);
          localStorage.removeItem(STORAGE_KEYS.PARTS);
          loadAppState();
          refreshAllViews();
          showToast("Data berhasil dikembalikan ke 61 transaksi awal.", "info");
        }
      );
    }

    // 11. TOAST NOTIFICATION SYSTEM
    function showToast(message, type = "info") {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');

      const styles = {
        success: "bg-emerald-900 text-white border-emerald-700",
        error: "bg-rose-900 text-white border-rose-700",
        info: "bg-slate-900 text-white border-slate-700"
      };

      const icons = {
        success: "check-circle-2",
        error: "alert-circle",
        info: "info"
      };

      toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl border shadow-lg text-xs sm:text-sm font-medium transition-all duration-300 translate-y-2 opacity-0 ${styles[type] || styles.info}`;
      toast.innerHTML = `
        <i data-lucide="${icons[type] || 'info'}" class="w-4 h-4 shrink-0"></i>
        <span class="flex-1">${message}</span>
      `;

      container.appendChild(toast);
      lucide.createIcons();

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // 12. GLOBAL REFRESH & BOOTSTRAP
    function refreshAllViews() {
      renderDashboard();
      populateClaimFilterDropdowns();
      renderClaimsTable();
      renderMasterTables();
      lucide.createIcons();
    }

    window.addEventListener('DOMContentLoaded', () => {
      loadAppState();
      refreshAllViews();
    });
  </script>

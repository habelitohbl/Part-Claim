    // LocalStorage Keys
    const STORAGE_KEYS = {
      CLAIMS: 'audit_claim_records_v1',
      DEALERS: 'audit_claim_dealers_v1',
      PARTS: 'audit_claim_parts_v1'
    };

    // Application State
    let claimsData = [];
    let dealersMaster = [];
    let partsMaster = [];
    let dealerRecapMode = 'active'; // 'active' or 'all'
    let dealerChartInstance = null;
    let kendalaChartInstance = null;

    // 2. INITIALIZATION & STORAGE MANAGEMENT
    function loadAppState() {
      try {
        const savedClaims = localStorage.getItem(STORAGE_KEYS.CLAIMS);
        const savedDealers = localStorage.getItem(STORAGE_KEYS.DEALERS);
        const savedParts = localStorage.getItem(STORAGE_KEYS.PARTS);

        claimsData = savedClaims ? JSON.parse(savedClaims) : JSON.parse(JSON.stringify(INITIAL_CLAIMS_DATA));
        dealersMaster = savedDealers ? JSON.parse(savedDealers) : [...INITIAL_DEALERS];

        if (savedParts) {
          partsMaster = JSON.parse(savedParts);
        } else {
          partsMaster = buildDefaultPartsCatalog(claimsData);
        }
        saveAppState();
      } catch (e) {
        console.error("Gagal memuat state dari localStorage:", e);
        claimsData = JSON.parse(JSON.stringify(INITIAL_CLAIMS_DATA));
        dealersMaster = [...INITIAL_DEALERS];
        partsMaster = buildDefaultPartsCatalog(claimsData);
      }
    }

    function saveAppState() {
      try {
        localStorage.setItem(STORAGE_KEYS.CLAIMS, JSON.stringify(claimsData));
        localStorage.setItem(STORAGE_KEYS.DEALERS, JSON.stringify(dealersMaster));
        localStorage.setItem(STORAGE_KEYS.PARTS, JSON.stringify(partsMaster));
      } catch (e) {
        console.error("Gagal menyimpan ke localStorage:", e);
      }
    }

    function buildDefaultPartsCatalog(dataList) {
      const map = new Map();
      dataList.forEach(item => {
        const pn = (item.partNumber || "").trim().toUpperCase();
        if (pn && !map.has(pn)) {
          const unitPrice = item.qty > 0 ? Math.round((item.orderAmount / item.qty) * 100) / 100 : item.orderAmount;
          map.set(pn, {
            partNumber: pn,
            namaPart: (item.namaPart || "").trim().toUpperCase(),
            unitPrice: unitPrice
          });
        }
      });
      return Array.from(map.values()).sort((a, b) => a.partNumber.localeCompare(b.partNumber));
    }

    // 3. CORE CALCULATION FORMULAS (SESUAI RUMUS EXCEL ASLI)
    function getTodayISO() {
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const d = String(now.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    function calculateStatus(tglAdjust) {
      return (tglAdjust && String(tglAdjust).trim() !== "") ? "Adjusted" : "Not Adjusted";
    }

    function calculateLeadTime(tglPengajuan, tglAdjust) {
      if (!tglPengajuan) return 0;
      const start = new Date(tglPengajuan + "T00:00:00");
      const endStr = (tglAdjust && String(tglAdjust).trim() !== "") ? tglAdjust : getTodayISO();
      const end = new Date(endStr + "T00:00:00");
      if (isNaN(start.getTime()) || isNaN(end.getTime())) return 0;
      const diffMs = end.getTime() - start.getTime();
      return Math.round(diffMs / (1000 * 60 * 60 * 24));
    }

    function enrichClaimRecord(item) {
      const status = calculateStatus(item.tglAdjust);
      const leadTime = calculateLeadTime(item.tglPengajuan, item.tglAdjust);
      return {
        ...item,
        status,
        leadTime
      };
    }

    // Formatting Helpers
    function formatRupiah(num) {
      const val = Math.round(Number(num) || 0);
      return "Rp " + val.toLocaleString("id-ID");
    }

    function formatDateDisplay(isoStr) {
      if (!isoStr || String(isoStr).trim() === "") return "-";
      const parts = isoStr.split("-");
      if (parts.length !== 3) return isoStr;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    // 4. NAVIGATION & TAB SWITCHING
    function switchTab(tabName) {
      const tabs = ['dashboard', 'claims', 'master'];
      tabs.forEach(t => {
        const viewEl = document.getElementById(`view-${t}`);
        const btnEl = document.getElementById(`tab-btn-${t}`);
        if (t === tabName) {
          viewEl.classList.remove('hidden');
          btnEl.classList.remove('text-slate-600', 'hover:bg-slate-100', 'font-medium');
          btnEl.classList.add('bg-indigo-50', 'text-indigo-700', 'font-semibold');
        } else {
          viewEl.classList.add('hidden');
          btnEl.classList.remove('bg-indigo-50', 'text-indigo-700', 'font-semibold');
          btnEl.classList.add('text-slate-600', 'hover:bg-slate-100', 'font-medium');
        }
      });

      if (tabName === 'dashboard') {
        renderDashboard();
      } else if (tabName === 'claims') {
        populateClaimFilterDropdowns();
        renderClaimsTable();
      } else if (tabName === 'master') {
        renderMasterTables();
      }
      lucide.createIcons();
    }

    // 5. DASHBOARD RENDERING (KPI, CHARTS & RECAP TABLES)
    function renderDashboard() {
      const enriched = claimsData.map(enrichClaimRecord);

      // KPI Calculations
      const totalPengajuan = enriched.length;
      const belumAdjust = enriched.filter(c => c.status === "Not Adjusted").length;
      const sudahAdjust = enriched.filter(c => c.status === "Adjusted").length;
      const totalPart = enriched.reduce((sum, c) => sum + (Number(c.qty) || 0), 0);
      const nilaiClaim = enriched.reduce((sum, c) => sum + (Number(c.orderAmount) || 0), 0);
      const totalLeadTime = enriched.reduce((sum, c) => sum + c.leadTime, 0);
      const avgLeadTime = totalPengajuan > 0 ? (totalLeadTime / totalPengajuan).toFixed(1) : "0.0";

      const belumPct = totalPengajuan > 0 ? ((belumAdjust / totalPengajuan) * 100).toFixed(1) : "0.0";
      const sudahPct = totalPengajuan > 0 ? ((sudahAdjust / totalPengajuan) * 100).toFixed(1) : "0.0";

      // Update DOM KPIs
      document.getElementById('kpi-total-pengajuan').textContent = totalPengajuan;
      document.getElementById('badge-total-claims').textContent = totalPengajuan;
      document.getElementById('kpi-belum-adjust').textContent = belumAdjust;
      document.getElementById('kpi-belum-pct').textContent = `(${belumPct}%)`;
      document.getElementById('kpi-sudah-adjust').textContent = sudahAdjust;
      document.getElementById('kpi-sudah-pct').textContent = `(${sudahPct}%)`;
      document.getElementById('kpi-total-part').textContent = totalPart;
      document.getElementById('kpi-nilai-claim').textContent = formatRupiah(nilaiClaim);
      document.getElementById('kpi-avg-leadtime').textContent = avgLeadTime;

      // Aggregate per Dealer
      const allDealerCodes = Array.from(new Set([...dealersMaster, ...enriched.map(c => c.dealer)]));
      const dealerStats = allDealerCodes.map(dealer => {
        const rows = enriched.filter(c => c.dealer === dealer);
        return {
          dealer,
          count: rows.length,
          partQty: rows.reduce((s, r) => s + (Number(r.qty) || 0), 0),
          amount: rows.reduce((s, r) => s + (Number(r.orderAmount) || 0), 0),
          unadjusted: rows.filter(r => r.status === "Not Adjusted").length
        };
      });

      const activeDealerStats = dealerStats
        .filter(d => d.count > 0)
        .sort((a, b) => b.amount - a.amount);

      const displayDealerStats = dealerRecapMode === 'active'
        ? activeDealerStats
        : dealerStats.sort((a, b) => b.amount - a.amount || a.dealer.localeCompare(b.dealer));

      // Render Dealer Recap Table
      const dealerTbody = document.getElementById('recap-dealer-tbody');
      dealerTbody.innerHTML = displayDealerStats.map(d => `
        <tr onclick="drillDownDealer('${d.dealer}')" class="hover:bg-indigo-50/60 transition cursor-pointer ${d.count === 0 ? 'opacity-50' : ''}">
          <td class="py-2.5 px-4 font-semibold text-slate-800 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full ${d.unadjusted > 0 ? 'bg-amber-500' : (d.count > 0 ? 'bg-emerald-500' : 'bg-slate-300')}"></span>
            <span>${d.dealer}</span>
          </td>
          <td class="py-2.5 px-4 text-right font-medium text-slate-700">${d.partQty}</td>
          <td class="py-2.5 px-4 text-right font-semibold text-slate-900">${formatRupiah(d.amount)}</td>
          <td class="py-2.5 px-4 text-center">
            ${d.unadjusted > 0 
              ? `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">${d.unadjusted}</span>`
              : `<span class="text-xs text-slate-400">0</span>`
            }
          </td>
        </tr>
      `).join('');

      document.getElementById('recap-dealer-total-part').textContent = totalPart;
      document.getElementById('recap-dealer-total-amount').textContent = formatRupiah(nilaiClaim);
      document.getElementById('recap-dealer-total-unadjusted').textContent = belumAdjust;

      // Aggregate per Kendala
      const kendalaSet = new Set([...STANDARD_KENDALA_LIST, ...enriched.map(c => c.kendala)]);
      const kendalaStats = Array.from(kendalaSet).map(k => {
        const count = enriched.filter(c => c.kendala === k).length;
        const pct = totalPengajuan > 0 ? ((count / totalPengajuan) * 100).toFixed(1) : "0.0";
        return { kendala: k, count, pct };
      }).sort((a, b) => b.count - a.count);

      const kendalaTbody = document.getElementById('recap-kendala-tbody');
      kendalaTbody.innerHTML = kendalaStats.map(k => `
        <tr onclick="drillDownKendala('${k.kendala.replace(/'/g, "\\'")}')" class="hover:bg-indigo-50/60 transition cursor-pointer ${k.count === 0 ? 'opacity-50' : ''}">
          <td class="py-2.5 px-4 font-medium text-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 ${getKendalaColorClass(k.kendala)}"></span>
              <span class="line-clamp-2">${k.kendala}</span>
            </div>
          </td>
          <td class="py-2.5 px-4 text-right font-bold text-slate-900">${k.count}</td>
          <td class="py-2.5 px-4 text-right text-slate-600 font-medium">${k.pct}%</td>
        </tr>
      `).join('');

      document.getElementById('recap-kendala-total-count').textContent = totalPengajuan;

      // Render Charts
      renderCharts(activeDealerStats, kendalaStats.filter(k => k.count > 0));
    }

    function getKendalaColorClass(kendala) {
      if (kendala === "Claim Complete") return "bg-emerald-500";
      if (kendala === "Verifikasi Part") return "bg-amber-500";
      if (kendala === "Sudah Diinput, Menunggu Diadjust") return "bg-blue-500";
      if (kendala === "Dokumen Kurang") return "bg-rose-500";
      if (kendala === "Form Claim Tidak Lengkap") return "bg-purple-500";
      return "bg-slate-500";
    }

    function setDealerRecapMode(mode) {
      dealerRecapMode = mode;
      const btnActive = document.getElementById('btn-dealer-active');
      const btnAll = document.getElementById('btn-dealer-all');

      if (mode === 'active') {
        btnActive.className = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-indigo-700 shadow-xs transition cursor-pointer";
        btnAll.className = "px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 transition cursor-pointer";
      } else {
        btnAll.className = "px-3 py-1.5 rounded-lg text-xs font-semibold bg-white text-indigo-700 shadow-xs transition cursor-pointer";
        btnActive.className = "px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 transition cursor-pointer";
      }
      renderDashboard();
    }

    function renderCharts(activeDealerStats, activeKendalaStats) {
      // 1. Dealer Bar + Line Chart
      const ctxDealer = document.getElementById('dealerChart').getContext('2d');
      if (dealerChartInstance) dealerChartInstance.destroy();

      dealerChartInstance = new Chart(ctxDealer, {
        type: 'bar',
        data: {
          labels: activeDealerStats.map(d => d.dealer),
          datasets: [
            {
              label: 'Nilai Claim (Rp)',
              data: activeDealerStats.map(d => Math.round(d.amount)),
              backgroundColor: 'rgba(79, 70, 229, 0.85)',
              borderRadius: 6,
              yAxisID: 'y',
              order: 2
            },
            {
              label: 'Belum Adjust (Kasus)',
              data: activeDealerStats.map(d => d.unadjusted),
              type: 'line',
              borderColor: '#f59e0b',
              backgroundColor: '#f59e0b',
              borderWidth: 2.5,
              pointRadius: 4,
              pointHoverRadius: 6,
              tension: 0.25,
              yAxisID: 'y1',
              order: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { position: 'top', labels: { usePointStyle: true, font: { family: 'Inter', size: 11 } } },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  if (ctx.dataset.yAxisID === 'y') {
                    return ` Nilai Claim: ${formatRupiah(ctx.raw)}`;
                  }
                  return ` Belum Adjust: ${ctx.raw} kasus`;
                }
              }
            }
          },
          scales: {
            x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 11, weight: '600' } } },
            y: {
              type: 'linear',
              position: 'left',
              beginAtZero: true,
              ticks: {
                font: { family: 'Inter', size: 10 },
                callback: (val) => 'Rp ' + (val / 1000000).toFixed(1) + 'jt'
              },
              grid: { color: '#f1f5f9' }
            },
            y1: {
              type: 'linear',
              position: 'right',
              beginAtZero: true,
              grid: { drawOnChartArea: false },
              ticks: { stepSize: 1, font: { family: 'Inter', size: 10 } }
            }
          }
        }
      });

      // 2. Kendala Doughnut Chart
      const ctxKendala = document.getElementById('kendalaChart').getContext('2d');
      if (kendalaChartInstance) kendalaChartInstance.destroy();

      const palette = ['#10b981', '#f59e0b', '#3b82f6', '#f43f5e', '#8b5cf6', '#64748b'];

      kendalaChartInstance = new Chart(ctxKendala, {
        type: 'doughnut',
        data: {
          labels: activeKendalaStats.map(k => k.kendala),
          datasets: [{
            data: activeKendalaStats.map(k => k.count),
            backgroundColor: activeKendalaStats.map((_, idx) => palette[idx % palette.length]),
            borderWidth: 2,
            borderColor: '#ffffff',
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '62%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                usePointStyle: true,
                padding: 14,
                font: { family: 'Inter', size: 11 }
              }
            },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                  const pct = total > 0 ? ((ctx.raw / total) * 100).toFixed(1) : 0;
                  return ` ${ctx.label}: ${ctx.raw} kasus (${pct}%)`;
                }
              }
            }
          }
        }
      });
    }


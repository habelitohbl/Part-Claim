      const cleanPN = val.trim().toUpperCase();
      const found = partsMaster.find(p => p.partNumber.toUpperCase() === cleanPN);
      const hintEl = document.getElementById('part-catalog-hint');

      if (found) {
        document.getElementById('form-nama-part').value = found.namaPart;

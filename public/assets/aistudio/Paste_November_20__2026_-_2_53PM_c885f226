    function renderClaimsTable() {
      const searchQ = document.getElementById('filter-search').value.trim().toLowerCase();
      const dealerF = document.getElementById('filter-dealer').value;
      const statusF = document.getElementById('filter-status').value;
      const kendalaF = document.getElementById('filter-kendala').value;

      const enriched = claimsData.map(enrichClaimRecord);

      const filtered = enriched.filter(item => {
        if (dealerF && item.dealer !== dealerF) return false;
        if (statusF && item.status !== statusF) return false;
        if (kendalaF && item.kendala !== kendalaF) return false;
        if (searchQ) {
          const hay = `${item.no} ${item.dealer} ${item.partNumber} ${item.namaPart} ${item.kendala}`.toLowerCase();
          if (!hay.includes(searchQ)) return false;
        }
        return true;
      });

      // Update summary bar
      document.getElementById('filtered-count').textContent = filtered.length;
      document.getElementById('total-records-count').textContent = enriched.length;
      const subAmount = filtered.reduce((s, r) => s + (Number(r.orderAmount) || 0), 0);
      const subQty = filtered.reduce((s, r) => s + (Number(r.qty) || 0), 0);
      document.getElementById('filtered-amount').textContent = formatRupiah(subAmount);
      document.getElementById('filtered-qty').textContent = subQty;

      const tbody = document.getElementById('claims-tbody');
      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="13" class="py-12 text-center text-slate-400">
              <div class="flex flex-col items-center gap-2">
                <i data-lucide="inbox" class="w-8 h-8 text-slate-300"></i>
                <p class="text-sm font-medium text-slate-500">Tidak ada data claim yang cocok dengan filter pencarian.</p>
              </div>
            </td>
          </tr>
        `;
        lucide.createIcons();
        return;
      }

      tbody.innerHTML = filtered.map(row => {
        const isAdjusted = row.status === "Adjusted";
        const statusBadge = isAdjusted
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Adjusted</span>`
          : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Not Adjusted</span>`;

        const leadTimeColor = row.leadTime > 120 ? 'text-rose-600 font-bold' : (row.leadTime > 60 ? 'text-amber-600 font-semibold' : 'text-slate-700 font-medium');

        return `
          <tr class="hover:bg-slate-50/90 transition group">
            <td class="py-3 px-3 text-center font-semibold text-slate-500">${row.no}</td>
            <td class="py-3 px-3 text-slate-700">${formatDateDisplay(row.tglPengajuan)}</td>
            <td class="py-3 px-3">
              <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-800 font-bold text-xs">${row.dealer}</span>
            </td>
            <td class="py-3 px-3 text-slate-600">${formatDateDisplay(row.tglAudit)}</td>
            <td class="py-3 px-3 font-mono text-xs font-semibold text-indigo-700">${row.partNumber}</td>
            <td class="py-3 px-3 text-slate-800 max-w-[220px] truncate" title="${row.namaPart}">${row.namaPart}</td>
            <td class="py-3 px-3 text-center font-semibold text-slate-800">${row.qty}</td>
            <td class="py-3 px-3 text-right font-semibold text-slate-900">${formatRupiah(row.orderAmount)}</td>
            <td class="py-3 px-3 text-slate-700">${formatDateDisplay(row.tglAdjust)}</td>
            <td class="py-3 px-3 text-center">${statusBadge}</td>
            <td class="py-3 px-3 text-right ${leadTimeColor}">${row.leadTime} hr</td>
            <td class="py-3 px-3 text-slate-700 max-w-[210px] truncate" title="${row.kendala}">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full shrink-0 ${getKendalaColorClass(row.kendala)}"></span>
                <span>${row.kendala}</span>
              </span>
            </td>

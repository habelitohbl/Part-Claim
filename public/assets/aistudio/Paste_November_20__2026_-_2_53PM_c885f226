    const STANDARD_KENDALA_LIST = [
      "Claim Complete",
      "Verifikasi Part",
      "Sudah Diinput, Menunggu Diadjust",
      "Dokumen Kurang",
      "Form Claim Tidak Lengkap",
      "Salah kirim form claim, petugas claim tidak follow up ke dealer"

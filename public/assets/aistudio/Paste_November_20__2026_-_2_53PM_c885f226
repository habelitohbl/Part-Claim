    function handleAddMasterPart(e) {
      e.preventDefault();
      const pn = document.getElementById('new-part-number').value.trim().toUpperCase();
      const name = document.getElementById('new-part-name').value.trim().toUpperCase();
      const price = Math.max(0, Number(document.getElementById('new-part-price').value) || 0);

      const idx = partsMaster.findIndex(p => p.partNumber === pn);

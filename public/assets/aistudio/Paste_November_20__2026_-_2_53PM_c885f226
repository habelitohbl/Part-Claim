    function handleClaimFormSubmit(e) {
      e.preventDefault();

      const editNoRaw = document.getElementById('form-claim-no').value;
      const tglPengajuan = document.getElementById('form-tgl-pengajuan').value;
      const dealer = document.getElementById('form-dealer').value.trim().toUpperCase();
      const tglAudit = document.getElementById('form-tgl-audit').value;
      const partNumber = document.getElementById('form-part-number').value.trim().toUpperCase();
      const namaPart = document.getElementById('form-nama-part').value.trim().toUpperCase();
      const qty = Math.max(1, Number(document.getElementById('form-qty').value) || 1);
      const orderAmount = Math.max(0, Number(document.getElementById('form-order-amount').value) || 0);
      const tglAdjust = document.getElementById('form-tgl-adjust').value || "";

      const kendalaSel = document.getElementById('form-kendala-select').value;
      const kendala = kendalaSel === "__CUSTOM__"
        ? document.getElementById('form-kendala-custom').value.trim()
        : kendalaSel;

      // Auto-register dealer if new
      if (dealer && !dealersMaster.includes(dealer)) {
        dealersMaster.push(dealer);
      }

      // Auto-register or update part catalog
      const unitPrice = qty > 0 ? Math.round((orderAmount / qty) * 100) / 100 : orderAmount;
      const existingPartIdx = partsMaster.findIndex(p => p.partNumber === partNumber);
      if (existingPartIdx === -1) {
        partsMaster.push({ partNumber, namaPart, unitPrice });
        partsMaster.sort((a, b) => a.partNumber.localeCompare(b.partNumber));
      }

      if (editNoRaw !== "") {
        const editNo = Number(editNoRaw);
        const idx = claimsData.findIndex(c => c.no === editNo);
        if (idx !== -1) {
          claimsData[idx] = {
            no: editNo,
            tglPengajuan,
            dealer,
            tglAudit,
            partNumber,
            namaPart,
            qty,
            orderAmount,
            tglAdjust,
            kendala
          };
          showToast(`Data Claim #${editNo} berhasil diperbarui.`, "success");
        }
      } else {
        const nextNo = claimsData.length > 0 ? Math.max(...claimsData.map(c => c.no)) + 1 : 1;
        claimsData.push({
          no: nextNo,
          tglPengajuan,
          dealer,
          tglAudit,
          partNumber,
          namaPart,
          qty,
          orderAmount,
          tglAdjust,
          kendala
        });
        showToast(`Pengajuan Claim baru #${nextNo} (${dealer}) berhasil ditambahkan.`, "success");
      }

      saveAppState();
      closeClaimModal();
      refreshAllViews();
    }

    // Quick Adjust Action
    function quickAdjustClaim(no) {
      const idx = claimsData.findIndex(c => c.no === no);
      if (idx === -1) return;
      claimsData[idx].tglAdjust = getTodayISO();
      claimsData[idx].kendala = "Claim Complete";
      saveAppState();
      refreshAllViews();
      showToast(`Claim #${no} ditandai Adjusted per hari ini.`, "success");
    }

    // Delete Claim Action
    function confirmDeleteClaim(no) {
      openConfirmModal(
        `Hapus Data Claim #${no}?`,
        `Transaksi claim #${no} akan dihapus dari daftar. Tindakan ini dapat dibatalkan dengan Reset Data Awal.`,

    const INITIAL_DEALERS = [
      "SY", "TB PRO", "TB PDK", "TB ADS", "TB LBG", "TB BDB", "TB STB", "TB BLB", "TB TBG",
      "TB LBB", "TB LAG", "TB SCC", "TB PRM", "TB KNL", "TB SP4", "TB LSK", "TB PPJ", "TB PDL",

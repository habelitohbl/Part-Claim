          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Qty (Unit) <span class="text-rose-500">*</span></label>
            <input type="number" id="form-qty" min="1" value="1" required oninput="handleQtyChange()" class="w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>

          <!-- Order Amount -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Order Amount (Rp) <span class="text-rose-500">*</span></label>
            <input type="number" id="form-order-amount" min="0" step="any" required placeholder="0" class="w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>

          <!-- Tanggal Adjust -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Tgl Adjust <span class="text-slate-400 font-normal">(Opsional)</span></label>

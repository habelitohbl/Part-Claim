    <div class="bg-white rounded-2xl max-w-2xl w-full shadow-2xl border border-slate-200 overflow-hidden my-auto">
      <!-- Modal Header -->
      <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="p-2 rounded-xl bg-indigo-100 text-indigo-700">
            <i data-lucide="file-plus-2" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 id="claim-modal-title" class="text-base font-bold text-slate-900">Input Pengajuan Claim Baru</h3>

              <div class="inline-flex items-center gap-1">
                ${!isAdjusted ? `
                  <button onclick="quickAdjustClaim(${row.no})" class="p-1.5 rounded-lg text-emerald-600 hover:bg-emerald-50 transition cursor-pointer" title="Quick Adjust Hari Ini">

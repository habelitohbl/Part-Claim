        titleEl.textContent = `Edit Data Claim #${record.no}`;
        document.getElementById('form-claim-no').value = record.no;
        document.getElementById('form-tgl-pengajuan').value = record.tglPengajuan;
        document.getElementById('form-dealer').value = record.dealer;

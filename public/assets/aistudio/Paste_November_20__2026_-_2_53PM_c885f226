      <form id="claim-form" onsubmit="handleClaimFormSubmit(event)" class="p-6 space-y-4">
        <input type="hidden" id="form-claim-no" />

        <!-- Live Calculation Preview Banner -->
        <div class="bg-indigo-50/80 border border-indigo-100 rounded-xl p-3.5 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-medium text-slate-600">Status Otomatis:</span>
            <span id="preview-status-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">Not Adjusted</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-medium text-slate-600">Estimasi Lead Time:</span>
            <span id="preview-leadtime-text" class="text-sm font-extrabold text-indigo-700">0 Hari</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Tanggal Pengajuan Claim -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Tgl Pengajuan Claim <span class="text-rose-500">*</span></label>
            <input type="date" id="form-tgl-pengajuan" required onchange="updateFormPreviews()" class="w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>

          <!-- Dealer Selector -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Kode Dealer <span class="text-rose-500">*</span></label>
            <input type="text" id="form-dealer" list="dealer-datalist" required placeholder="Pilih / ketik dealer..." class="w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl uppercase focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <datalist id="dealer-datalist"></datalist>
          </div>

          <!-- Tanggal Audit -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Tgl Audit <span class="text-rose-500">*</span></label>
            <input type="date" id="form-tgl-audit" required class="w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
        </div>

        <!-- Smart Part Number & Nama Part -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
          <div class="sm:col-span-5">
            <label class="block text-xs font-semibold text-slate-700 mb-1">Part Number <span class="text-rose-500">*</span></label>
            <input type="text" id="form-part-number" list="part-datalist" required oninput="handlePartNumberInput(this.value)" placeholder="Pilih atau ketik baru..." class="w-full px-3 py-2 text-sm bg-white border border-slate-300 rounded-xl uppercase font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500" />

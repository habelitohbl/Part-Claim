    function handleAddMasterDealer(e) {
      e.preventDefault();
      const code = document.getElementById('new-dealer-code').value.trim().toUpperCase();
      if (!code) return;
      if (!dealersMaster.includes(code)) {
        dealersMaster.push(code);
        saveAppState();
        renderMasterTables();
        showToast(`Dealer ${code} berhasil ditambahkan.`, "success");
      } else {
        showToast(`Dealer ${code} sudah terdaftar.`, "info");
      }
      e.target.reset();
